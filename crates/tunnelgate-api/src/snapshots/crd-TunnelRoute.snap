---
source: crates/tunnelgate-api/src/lib.rs
expression: crd
---
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: tunnelroutes.tunnelgate.geeko.me
spec:
  group: tunnelgate.geeko.me
  names:
    categories:
      - tunnelgate
    kind: TunnelRoute
    plural: tunnelroutes
    shortNames:
      - tr
    singular: tunnelroute
  scope: Namespaced
  versions:
    - additionalPrinterColumns:
        - jsonPath: ".spec.hostname"
          name: Hostname
          type: string
        - jsonPath: ".spec.path"
          name: Path
          type: string
        - jsonPath: ".spec.tunnelRef.name"
          name: Tunnel
          type: string
        - jsonPath: ".status.conditions[?(@.type==\"Ready\")].status"
          name: Ready
          type: string
        - jsonPath: ".metadata.creationTimestamp"
          name: Age
          type: date
      name: v1alpha1
      schema:
        openAPIV3Schema:
          description: A public hostname (and optional path) routed through a Tunnel to an origin.
          properties:
            spec:
              description: One public hostname (and optionally a path) mapped to an origin.
              properties:
                access:
                  nullable: true
                  properties:
                    applicationRefs:
                      default: []
                      description: "AccessApplications protecting this route; `AccessReady` reflects their readiness."
                      items:
                        description: "A reference to an object of a known kind, optionally in another namespace."
                        properties:
                          name:
                            type: string
                          namespace:
                            description: "Defaults to the referring resource's namespace."
                            nullable: true
                            type: string
                        required:
                          - name
                        type: object
                      type: array
                  type: object
                dns:
                  default:
                    adopt: false
                    enabled: true
                  properties:
                    adopt:
                      default: false
                      description: "Take over an existing record that isn't marked as owned by this route."
                      type: boolean
                    enabled:
                      default: true
                      description: Create the proxied CNAME to the tunnel (default true).
                      type: boolean
                    zone:
                      description: "Zone to create the record in. Default: the longest zone suffix the token can see."
                      nullable: true
                      type: string
                  type: object
                hostname:
                  description: "Public hostname; `*.example.com` for a wildcard."
                  type: string
                  x-kubernetes-validations:
                    - message: "must be a lowercase DNS name, optionally starting with '*.'"
                      rule: "self.matches('^(\\\\*\\\\.)?([a-z0-9]([-a-z0-9]*[a-z0-9])?\\\\.)+[a-z]{2,}$')"
                origin:
                  description: "Overrides for `Tunnel.spec.originDefaults`."
                  nullable: true
                  properties:
                    connectTimeout:
                      nullable: true
                      type: string
                      x-kubernetes-validations:
                        - rule: "self.matches('^([0-9]+(ms|s|m|h))+$')"
                    disableChunkedEncoding:
                      nullable: true
                      type: boolean
                    http2:
                      description: HTTP/2 to the origin.
                      nullable: true
                      type: boolean
                    httpHostHeader:
                      nullable: true
                      type: string
                    keepAliveTimeout:
                      nullable: true
                      type: string
                      x-kubernetes-validations:
                        - rule: "self.matches('^([0-9]+(ms|s|m|h))+$')"
                    noHappyEyeballs:
                      nullable: true
                      type: boolean
                    noTLSVerify:
                      nullable: true
                      type: boolean
                    protocol:
                      description: "Scheme used for `backendRef` (default `http`)."
                      enum:
                        - http
                        - https
                        - ~
                      nullable: true
                      type: string
                    serverName:
                      description: SNI and the name the origin certificate is verified against.
                      nullable: true
                      type: string
                  type: object
                path:
                  description: "Cloudflare ingress path (a regular expression matched against the request path).\nEmpty means the whole host."
                  nullable: true
                  type: string
                service:
                  description: "Where requests go: exactly one of `backendRef`, `url` or `status`."
                  properties:
                    backendRef:
                      description: A Kubernetes Service port.
                      nullable: true
                      properties:
                        name:
                          type: string
                        namespace:
                          description: "Defaults to the route's namespace. Another namespace needs a grant there."
                          nullable: true
                          type: string
                        port:
                          format: int32
                          maximum: 65535
                          minimum: 1
                          type: integer
                      required:
                        - name
                        - port
                      type: object
                    status:
                      description: "A fixed HTTP status (`http_status:<code>`)."
                      format: uint16
                      maximum: 599
                      minimum: 100
                      nullable: true
                      type: integer
                    url:
                      description: "Any URL cloudflared can reach, e.g. `https://192.0.2.10:443`."
                      nullable: true
                      type: string
                  type: object
                  x-kubernetes-validations:
                    - message: "set exactly one of backendRef, url or status"
                      rule: "[has(self.backendRef), has(self.url), has(self.status)].filter(x, x).size() == 1"
                tunnelRef:
                  description: The Tunnel to publish on. Another namespace needs a RouteGrant/ReferenceGrant there.
                  properties:
                    name:
                      type: string
                    namespace:
                      description: "Defaults to the referring resource's namespace."
                      nullable: true
                      type: string
                  required:
                    - name
                  type: object
              required:
                - hostname
                - service
                - tunnelRef
              type: object
            status:
              nullable: true
              properties:
                conditions:
                  items:
                    description: Condition contains details for one aspect of the current state of this API Resource.
                    properties:
                      lastTransitionTime:
                        description: "lastTransitionTime is the last time the condition transitioned from one status to another. This should be when the underlying condition changed.  If that is not known, then using the time when the API field changed is acceptable."
                        format: date-time
                        type: string
                      message:
                        description: message is a human readable message indicating details about the transition. This may be an empty string.
                        type: string
                      observedGeneration:
                        description: "observedGeneration represents the .metadata.generation that the condition was set based upon. For instance, if .metadata.generation is currently 12, but the .status.conditions[x].observedGeneration is 9, the condition is out of date with respect to the current state of the instance."
                        format: int64
                        type: integer
                      reason:
                        description: "reason contains a programmatic identifier indicating the reason for the condition's last transition. Producers of specific condition types may define expected values and meanings for this field, and whether the values are considered a guaranteed API. The value should be a CamelCase string. This field may not be empty."
                        type: string
                      status:
                        description: "status of the condition, one of True, False, Unknown."
                        type: string
                      type:
                        description: type of condition in CamelCase or in foo.example.com/CamelCase.
                        type: string
                    required:
                      - lastTransitionTime
                      - message
                      - reason
                      - status
                      - type
                    type: object
                  type: array
                dnsRecordId:
                  nullable: true
                  type: string
                observedGeneration:
                  format: int64
                  nullable: true
                  type: integer
                service:
                  description: Origin service rendered into the tunnel configuration.
                  nullable: true
                  type: string
                tunnelId:
                  nullable: true
                  type: string
                url:
                  nullable: true
                  type: string
                zoneId:
                  nullable: true
                  type: string
              type: object
          required:
            - spec
          title: TunnelRoute
          type: object
      served: true
      storage: true
      subresources:
        status: {}
