---
source: crates/tunnelgate-api/src/lib.rs
expression: crd
---
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: accesspolicies.tunnelgate.geeko.me
spec:
  group: tunnelgate.geeko.me
  names:
    categories:
      - tunnelgate
    kind: AccessPolicy
    plural: accesspolicies
    shortNames:
      - apol
    singular: accesspolicy
  scope: Namespaced
  versions:
    - additionalPrinterColumns:
        - jsonPath: ".spec.decision"
          name: Decision
          type: string
        - jsonPath: ".status.policyId"
          name: Policy ID
          type: string
        - jsonPath: ".status.conditions[?(@.type==\"Ready\")].status"
          name: Ready
          type: string
        - jsonPath: ".metadata.creationTimestamp"
          name: Age
          type: date
      name: v1alpha1
      schema:
        openAPIV3Schema:
          description: A reusable Cloudflare Access policy.
          properties:
            spec:
              description: A reusable Cloudflare Access policy (account level).
              properties:
                cloudflare:
                  description: "Which Cloudflare account to use and how to authenticate.\n\nEither `accountRef` (a cluster-scoped `CloudflareAccount`) or an inline account\n(`accountId` or `accountName`, plus `credentialsSecretRef`)."
                  properties:
                    accountId:
                      description: Cloudflare account ID.
                      nullable: true
                      type: string
                    accountName:
                      description: "Cloudflare account name, looked up through the API (needs Account Settings: Read)."
                      nullable: true
                      type: string
                    accountRef:
                      description: "Name of a cluster-scoped `CloudflareAccount`."
                      nullable: true
                      type: string
                    credentialsSecretRef:
                      description: "Secret in the resource's namespace holding the API token."
                      nullable: true
                      properties:
                        key:
                          description: "Key in the Secret's data; defaults depend on the field (`CLOUDFLARE_API_TOKEN`, `ca.crt`)."
                          nullable: true
                          type: string
                        name:
                          type: string
                      required:
                        - name
                      type: object
                  type: object
                  x-kubernetes-validations:
                    - message: "set either accountRef, or accountId/accountName with credentialsSecretRef"
                      rule: has(self.accountRef) != (has(self.accountId) || has(self.accountName))
                    - message: credentialsSecretRef is required with an inline accountId/accountName
                      rule: has(self.accountRef) || has(self.credentialsSecretRef)
                decision:
                  enum:
                    - allow
                    - deny
                    - bypass
                    - non_identity
                  type: string
                exclude:
                  description: None of these rules may match.
                  items:
                    description: "One Access rule group. Each set field expands to one or more Cloudflare rules; a list item\nnormally sets a single field."
                    properties:
                      anyValidServiceToken:
                        type: boolean
                      emailDomains:
                        items:
                          type: string
                        type: array
                      emails:
                        items:
                          type: string
                        type: array
                      everyone:
                        type: boolean
                      groups:
                        description: Access group IDs.
                        items:
                          type: string
                        type: array
                      ipRanges:
                        description: CIDRs.
                        items:
                          type: string
                        type: array
                      loginMethods:
                        description: Identity provider IDs.
                        items:
                          type: string
                        type: array
                      serviceTokens:
                        description: "`AccessServiceToken` resources."
                        items:
                          description: "A reference to an object of a known kind, optionally in another namespace."
                          properties:
                            name:
                              type: string
                            namespace:
                              description: "Defaults to the referring resource's namespace."
                              nullable: true
                              type: string
                          required:
                            - name
                          type: object
                        type: array
                    type: object
                  type: array
                include:
                  description: Any of these rules must match.
                  items:
                    description: "One Access rule group. Each set field expands to one or more Cloudflare rules; a list item\nnormally sets a single field."
                    properties:
                      anyValidServiceToken:
                        type: boolean
                      emailDomains:
                        items:
                          type: string
                        type: array
                      emails:
                        items:
                          type: string
                        type: array
                      everyone:
                        type: boolean
                      groups:
                        description: Access group IDs.
                        items:
                          type: string
                        type: array
                      ipRanges:
                        description: CIDRs.
                        items:
                          type: string
                        type: array
                      loginMethods:
                        description: Identity provider IDs.
                        items:
                          type: string
                        type: array
                      serviceTokens:
                        description: "`AccessServiceToken` resources."
                        items:
                          description: "A reference to an object of a known kind, optionally in another namespace."
                          properties:
                            name:
                              type: string
                            namespace:
                              description: "Defaults to the referring resource's namespace."
                              nullable: true
                              type: string
                          required:
                            - name
                          type: object
                        type: array
                    type: object
                  type: array
                  x-kubernetes-validations:
                    - message: include needs at least one rule
                      rule: size(self) > 0
                name:
                  description: "Name shown in Cloudflare (an ownership suffix is appended). Defaults to `<namespace>/<name>`."
                  nullable: true
                  type: string
                require:
                  description: All of these rules must match.
                  items:
                    description: "One Access rule group. Each set field expands to one or more Cloudflare rules; a list item\nnormally sets a single field."
                    properties:
                      anyValidServiceToken:
                        type: boolean
                      emailDomains:
                        items:
                          type: string
                        type: array
                      emails:
                        items:
                          type: string
                        type: array
                      everyone:
                        type: boolean
                      groups:
                        description: Access group IDs.
                        items:
                          type: string
                        type: array
                      ipRanges:
                        description: CIDRs.
                        items:
                          type: string
                        type: array
                      loginMethods:
                        description: Identity provider IDs.
                        items:
                          type: string
                        type: array
                      serviceTokens:
                        description: "`AccessServiceToken` resources."
                        items:
                          description: "A reference to an object of a known kind, optionally in another namespace."
                          properties:
                            name:
                              type: string
                            namespace:
                              description: "Defaults to the referring resource's namespace."
                              nullable: true
                              type: string
                          required:
                            - name
                          type: object
                        type: array
                    type: object
                  type: array
                sessionDuration:
                  nullable: true
                  type: string
                  x-kubernetes-validations:
                    - rule: "self.matches('^([0-9]+(ms|s|m|h))+$')"
              required:
                - cloudflare
                - decision
                - include
              type: object
            status:
              nullable: true
              properties:
                accountId:
                  nullable: true
                  type: string
                conditions:
                  items:
                    description: Condition contains details for one aspect of the current state of this API Resource.
                    properties:
                      lastTransitionTime:
                        description: "lastTransitionTime is the last time the condition transitioned from one status to another. This should be when the underlying condition changed.  If that is not known, then using the time when the API field changed is acceptable."
                        format: date-time
                        type: string
                      message:
                        description: message is a human readable message indicating details about the transition. This may be an empty string.
                        type: string
                      observedGeneration:
                        description: "observedGeneration represents the .metadata.generation that the condition was set based upon. For instance, if .metadata.generation is currently 12, but the .status.conditions[x].observedGeneration is 9, the condition is out of date with respect to the current state of the instance."
                        format: int64
                        type: integer
                      reason:
                        description: "reason contains a programmatic identifier indicating the reason for the condition's last transition. Producers of specific condition types may define expected values and meanings for this field, and whether the values are considered a guaranteed API. The value should be a CamelCase string. This field may not be empty."
                        type: string
                      status:
                        description: "status of the condition, one of True, False, Unknown."
                        type: string
                      type:
                        description: type of condition in CamelCase or in foo.example.com/CamelCase.
                        type: string
                    required:
                      - lastTransitionTime
                      - message
                      - reason
                      - status
                      - type
                    type: object
                  type: array
                observedGeneration:
                  format: int64
                  nullable: true
                  type: integer
                policyId:
                  nullable: true
                  type: string
              type: object
          required:
            - spec
          title: AccessPolicy
          type: object
      served: true
      storage: true
      subresources:
        status: {}
